# ===== Firebase web config (public client values — safe to expose in the bundle) =====
# Get these from: Firebase Console > Project Settings > Your apps > Web app
# The login screen only activates when VITE_FIREBASE_API_KEY and VITE_FIREBASE_APP_ID are real.
VITE_FIREBASE_API_KEY=YOUR_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=levelup-533c4.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=levelup-533c4
VITE_FIREBASE_APP_ID=YOUR_APP_ID
